# 通天晓业务层配置（复制为 .env 后修改）
# 注意：此文件仅业务层自身配置；BettaFish 基座配置在仓库根目录 .env

# 业务库（PostgreSQL；本机开发可用 sqlite:///./btx_dev.db）
BTX_DATABASE_URL=postgresql+psycopg2://bettafish:bettafish@localhost:5444/business
# JWT 密钥（生产环境必须更换）
BTX_JWT_SECRET=change-me-in-production
BTX_JWT_EXPIRE_MINUTES=1440
# BettaFish 基座地址
BTX_BETTAFISH_BASE_URL=http://localhost:5000
