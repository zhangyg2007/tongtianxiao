/* index.wxss */

/* 欢迎区域 */
.welcome-section {
  text-align: center;
  padding: 60rpx 20rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.welcome-title {
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  display: block;
}

.welcome-subtitle {
  font-size: 28rpx;
  opacity: 0.9;
  display: block;
}

/* 快速分析区域 */
.quick-analysis-section {
  margin-bottom: 30rpx;
}

/* 热门话题 */
.hot-topics-section {
  margin-bottom: 30rpx;
}

/* 最近分析 */
.recent-reports-section {
  margin-bottom: 120rpx;
}

/* 区域标题 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.more-link {
  font-size: 24rpx;
  color: #667eea;
}

/* 话题列表 */
.topic-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.topic-item {
  display: flex;
  align-items: center;
  background-color: #fff;
  padding: 20rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  cursor: pointer;
  transition: all 0.3s;
}

.topic-item:hover {
  transform: translateY(-2rpx);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.topic-rank {
  width: 50rpx;
  height: 50rpx;
  line-height: 50rpx;
  text-align: center;
  background-color: #667eea;
  color: #fff;
  font-weight: bold;
  border-radius: 8rpx;
  margin-right: 20rpx;
  font-size: 28rpx;
}

.topic-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.topic-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.topic-platform {
  font-size: 24rpx;
  color: #666;
  background-color: #f0f5ff;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  align-self: flex-start;
}

.topic-hotness {
  font-size: 24rpx;
  color: #ff4d4f;
}

/* 报告列表 */
.reports-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.report-item {
  background-color: #fff;
  padding: 20rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  cursor: pointer;
  transition: all 0.3s;
}

.report-item:hover {
  transform: translateY(-2rpx);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.report-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
  display: block;
}

.report-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.report-keyword {
  font-size: 24rpx;
  color: #666;
}

.report-time {
  font-size: 22rpx;
  color: #999;
}

.report-status {
  display: flex;
  justify-content: flex-end;
}

.status-tag {
  font-size: 22rpx;
  color: #fff;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  font-weight: bold;
}

/* 底部导航 */
.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-around;
  align-items: center;
  background-color: #fff;
  padding: 20rpx 0;
  border-top: 2rpx solid #eee;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  cursor: pointer;
}

.nav-icon {
  font-size: 40rpx;
}

.nav-text {
  font-size: 24rpx;
  color: #666;
}

.nav-item:active .nav-text {
  color: #667eea;
}

/* 响应式设计 */
@media (max-width: 768px) {
  .welcome-section {
    padding: 40rpx 20rpx;
  }
  
  .welcome-title {
    font-size: 40rpx;
  }
}
